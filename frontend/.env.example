# 서버 전용 값입니다. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요 (브라우저에 노출됩니다).
# 로컬에서는 이 파일을 .env.local 로 복사해 값을 채우세요. Vercel에서는 Environment Variables에 입력합니다.

# Supabase 프로젝트 주소 (Project Settings > API > Project URL)
SUPABASE_URL=

# service_role 키 또는 secret 키 (Project Settings > API). RLS를 우회하는 비밀 키이므로 저장소에 올리지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 금칙어 목록, 쉼표로 구분. 대소문자·공백을 무시하고 검사합니다. 비워 두면(BANNED_WORDS=) 금칙어 없음, 항목 자체를 지우면 기본 자리표시자(욕설,badword)를 씁니다.
BANNED_WORDS=욕설,badword
